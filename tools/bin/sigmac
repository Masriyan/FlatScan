#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SIGMA_TOOLS="$SCRIPT_DIR/../sigmac/legacy-sigmatools-0.21/tools"

case "${1:-}" in
  --version|-version|version)
    printf '%s\n' "sigmac 0.21 (legacy-sigmatools)"
    exit 0
    ;;
esac

export PYTHONPATH="$SIGMA_TOOLS${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore::SyntaxWarning}"
exec python3 "$SIGMA_TOOLS/sigmac" "$@"
